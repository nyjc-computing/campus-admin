# Campus Admin Portal configuration.
# Copy to .env and fill in the values. .env is gitignored and must never
# be committed.

# --- Required ---

# Flask session signing key. The app refuses to start without it.
# Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Semicolon-separated list of campus user ids allowed to use the admin
# routes (/clients, /users). A campus user id is the user's full email
# address, e.g. jane_doe@nyjc.edu.sg. Signed-in users not listed here
# get 403 on every admin route.
ADMINS=

# OAuth client credentials for this portal. campus-python runs in
# "server" mode and requires both. Register this portal's callback URI
# (see PUBLIC_URL below) as a redirect_uri on the client — you can do
# that through this portal's own Clients page once you can sign in, or
# with campus-cli.
CLIENT_ID=
CLIENT_SECRET=

# --- Recommended ---

# Public origin of this portal. The OAuth callback is
#   {PUBLIC_URL}/finalize_login
# and that exact URI must be registered as a redirect_uri on the OAuth
# client above (exact string match). For local development:
#   http://localhost:5000
# If unset, the callback falls back to https://{HOSTNAME}, which is
# deprecated and will not match URIs registered for a Railway deploy.
PUBLIC_URL=http://localhost:5000

# --- Optional ---

# Campus environment tier that campus-python resolves service base URLs
# from (CAMPUS_ENV is accepted as an alias when ENV is unset):
#   development (default) -> campusauth/campusapi-development.up.railway.app
#   staging               -> https://{service}.campus.nyjc.dev
#   production            -> https://{service}.campus.nyjc.app
#ENV=development

# Explicit service base URLs. When set, these take precedence over the
# ENV tier above. Use them for non-standard deployments (previews,
# locally running services, etc.).
#CAMPUS_AUTH_URL=
#CAMPUS_API_URL=
#CAMPUS_AUDIT_URL=

# --- Audit web UI (/audit) ---

# Comma-separated campus user ids (emails) allowed to use the audit web
# UI under /audit: the trace viewer and the API-key management page.
# An unset or empty value denies everyone (fail-closed). The list is
# re-read per request, so edits take effect on the next page load.
#AUDIT_ADMINS=

# Audit API key used server-side to reach campus.audit's versioned API
# on behalf of /audit (trace reads and key management). Mint it from
# the operator key with the traces:read, apikeys:read and apikeys:write
# scopes; it must NOT hold traces:write (span production is the tracing
# middleware's job, under AUDIT_API_KEY). Never exposed to the browser.
#AUDIT_UI_API_KEY=

# Audit trace production (campus#816/#828): when set truthy, admin
# requests are recorded as audit spans (and journeys), authenticated
# with AUDIT_API_KEY — a separate audit API key holding traces:write.
# Read once at app start; flipping it is a redeploy.
#AUDIT_TRACING_ENABLED=
#AUDIT_API_KEY=

# Deprecated and ignored for URL resolution: HOSTNAME, DEPLOY
# (HOSTNAME-derived base URLs were removed in campus-api-python#53;
# a DeprecationWarning is emitted if the environment would previously
# have used them).
