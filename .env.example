# Campus Admin Portal configuration.
# Copy to .env and fill in the values. .env is gitignored and must never
# be committed.

# --- Required ---

# Flask session signing key. The app refuses to start without it.
# Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# OAuth client credentials for this portal. campus-python runs in
# "server" mode and requires both. Register this portal's callback URI
# (see PUBLIC_URL below) as a redirect_uri on the client — you can do
# that through this portal's own Clients page once you can sign in, or
# with campus-cli.
#
# The portal's client is also its deployment's operator on campus.auth
# (list its id in the auth service's AUTH_OPERATOR_CLIENT_IDS). Two
# consequences for the Access Model (README):
#   - its allowed_scopes cap bounds what a designated admin's step-up
#     can request: the cap must cover every management vocabulary the
#     deployment expects designated admins to use
#     (clients:*, sessions:*, credentials:*, vaults:*, ...);
#   - accounts holding `admin` on ADMIN_CIRCLE drive this client as the
#     operator console.
CLIENT_ID=
CLIENT_SECRET=

# --- Recommended ---

# Public origin of this portal. The OAuth callback is
#   {PUBLIC_URL}/finalize_login
# and that exact URI must be registered as a redirect_uri on the OAuth
# client above (exact string match). For local development:
#   http://localhost:5000
# If unset, the callback falls back to https://{HOSTNAME}, which is
# deprecated and will not match URIs registered for a Railway deploy.
PUBLIC_URL=http://localhost:5000

# --- Optional ---

# The circle whose `admin` members are this portal's platform
# operators: they drive the portal as its operator client and get the
# full operator console. Defaults to `campus`, the platform-admin
# wildcard circle the campus.api bootstrap seeds (a reserved circle;
# `campus:admin` confers admin on every campus.api resource family
# too). Re-point it without a code change. Entry to the Admin section
# itself is campus.auth authority: a platform operator, or any account
# holding at least one access grant in the campus.auth grant store.
#ADMIN_CIRCLE=

# Campus environment tier that campus-python resolves service base URLs
# from (CAMPUS_ENV is accepted as an alias when ENV is unset):
#   development (default) -> campusauth/campusapi-development.up.railway.app
#   staging               -> https://{service}.campus.nyjc.dev
#   production            -> https://{service}.campus.nyjc.app
#ENV=development

# Explicit service base URLs. When set, these take precedence over the
# ENV tier above. Use them for non-standard deployments (previews,
# locally running services, etc.).
#CAMPUS_AUTH_URL=
#CAMPUS_API_URL=
#CAMPUS_AUDIT_URL=

# --- Audit web UI (/audit) ---

# campus.audit authorizes by API key and never authenticates a person.
# The portal signs the session in and decides locally who may drive its
# shared audit UI key, through the two lists below (comma-separated
# campus user ids; compared case-insensitively; re-read per request;
# unset or empty allows no one).

# Who may read traces in the audit web UI. Students may be listed here
# on the DEVELOPMENT deployment only — the production audit trail stays
# admin-only (campus docs/environment-access-policy.md).
#AUDIT_ADMINS=

# The audit superadmins, who may additionally manage API keys. Key
# management never opens to students. Unset, it falls back to
# AUDIT_ADMINS — so a deployment whose AUDIT_ADMINS is already the
# admin list needs no second variable. Set it explicitly wherever
# AUDIT_ADMINS is wider (e.g. development): name only the admins there.
# A list that is set but names no one allows no one.
#AUDIT_KEY_ADMINS=

# Audit API key used server-side to reach campus.audit's versioned API
# on behalf of /audit (trace reads and key management). Mint it from the
# operator key with the traces:read, apikeys:read and apikeys:write
# scopes; it must NOT hold traces:write (span production is the tracing
# middleware's job, under AUDIT_API_KEY). Never exposed to the browser.
# The Migrations view's audit section reuses this key for its calls to
# /audit/v1/admin/migrations (the audit service authenticates API keys,
# not campus bearers); without it that section renders as unconfigured.
#AUDIT_UI_API_KEY=

# Audit trace production (campus#816/#828): when set truthy, admin
# requests are recorded as audit spans (and journeys), authenticated
# with AUDIT_API_KEY — a separate audit API key holding traces:write.
# Read once at app start; flipping it is a redeploy.
#AUDIT_TRACING_ENABLED=
#AUDIT_API_KEY=

# Deprecated and ignored: HOSTNAME, DEPLOY (HOSTNAME-derived base URLs
# were removed in campus-api-python#53; a DeprecationWarning is emitted
# if the environment would previously have used them), and AUTH_ADMINS /
# ADMINS (portal allowlists that gated nothing since the circles gate
# replaced them; the Admin section is campus.auth authority now).
